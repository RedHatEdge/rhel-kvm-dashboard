#pmlogconf-setup 2.0
ident   host and per-VM metrics for the Hypervisor & VM Overview dashboard
probe   hinv.ncpu exists ? include : exclude
        ops.host.cpu.util
        ops.host.mem.util
        kernel.cpu.util.user
        kernel.cpu.util.sys
        kernel.cpu.util.wait
        kernel.cpu.util.steal
        libvirt.hv.domains.active
        libvirt.hv.domains.inactive
        ops.host.vms.running
        ops.host.vms.stopped
        openmetrics.libvirt_vms.state
        openmetrics.libvirt_vms.vms_defined
        openmetrics.libvirt_vms.vms_running
        openmetrics.libvirt_vms.vms_down_autostart
        openmetrics.libvirt_vms.vms_stopped
        openmetrics.pcp_hosts.up
        openmetrics.pcp_hosts.status
        openmetrics.pcp_hosts.hosts_total
        openmetrics.pcp_hosts.hosts_up
        openmetrics.pcp_hosts.hosts_down
        openmetrics.pcp_hosts.fleet_vms_running
        openmetrics.pcp_hosts.fleet_vms_down
        libvirt.dominfo.vcpu.current
        libvirt.dominfo.memory.current
        libvirt.domstats.balloon.rss
        libvirt.domstats.block.all.rd.bytes
        libvirt.domstats.block.all.wr.bytes
        libvirt.domstats.block.all.rd.reqs
        libvirt.domstats.block.all.wr.reqs
        libvirt.domstats.net.all.rx.bytes
        libvirt.domstats.net.all.tx.bytes
        libvirt.domstats.net.all.rx.drop
        libvirt.domstats.net.all.tx.drop
        ops.vm.cpu.util
        ops.vm.mem.util
